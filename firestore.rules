rules_version = '2';

// LifeReset — Firestore Security Rules
//
// Security model for authentication:
//  - The client NEVER decides its own role. `role` is always written as
//    "user" on create, and clients can never change `role` or `subscription`
//    on update — only the backend (Admin SDK, which bypasses rules) or an
//    existing admin may do so. This is what makes the app's role check
//    trustworthy: the value read from `users/{uid}.role` cannot be
//    self-elevated.
//  - Profiles are private to their owner (and admins).
//
// Deploy with: `firebase deploy --only firestore:rules`.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Reads the caller's own role from their existing user document.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      // Owners can read their own profile; admins can read any profile.
      allow read: if isOwner(uid) || isAdmin();

      // On create the client may only ever be a free "user", and the document
      // id must match the authenticated uid.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.subscription == 'free';

      // On update the owner may edit their profile but must NOT change their
      // own role or subscription; admins may update freely.
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.role == resource.data.role
            && request.resource.data.subscription == resource.data.subscription);

      // Deletion is an admin-only / backend operation.
      allow delete: if isAdmin();
    }

    // AI Coach conversations and their messages — private to the owner.
    match /users/{uid}/ai_conversations/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // Journal entries and mood history — private to the owner.
    match /users/{uid}/journal_entries/{entryId} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/mood_history/{moodId} {
      allow read, write: if isOwner(uid);
    }

    // Server-managed private data (e.g. AI message usage counter). Readable by
    // the owner for display; only the backend (Admin SDK) may write it, so the
    // daily message limit cannot be tampered with from the client.
    match /users/{uid}/private/{document=**} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Push-notification inbox. Created only by Cloud Functions (the sender);
    // the owner may read and mark items read / delete them.
    match /users/{uid}/notifications/{notifId} {
      allow read: if isOwner(uid);
      allow update, delete: if isOwner(uid);
      allow create: if false;
    }

    // FCM device tokens (document id = token). The owner registers, refreshes
    // and removes their own device tokens; Cloud Functions read them to target
    // sends. Clients never send messages — only register tokens.
    match /users/{uid}/fcm_tokens/{token} {
      allow read, write: if isOwner(uid);
    }

    // Shared recovery content — readable by any signed-in user, written only
    // by the backend/console (never by clients).
    // Shared recovery content — readable by any signed-in user; writable only
    // by admins (managed through the in-app Admin Panel).
    match /programs/{programId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /daily_tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Program day-tasks managed by the Admin Panel.
    match /program_tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /quotes/{quoteId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /journal_prompts/{promptId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin-authored notifications (sending logic is out of scope).
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Payment transactions (billing history). Written only by the payment
    // backend (Cloud Functions, Admin SDK). Readable by the owning user and by
    // admins.
    match /transactions/{txnId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Razorpay orders — one doc per created order, the idempotency anchor for
    // verification. Written only by Cloud Functions; readable by the owner.
    match /payments/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Per-user subscription record. Written only by Cloud Functions (the client
    // can never grant itself premium); readable by the owner and admins.
    match /subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // App-wide configuration / settings. Readable by any signed-in user (for
    // maintenance mode / version), writable only by admins.
    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin analytics: collection-group reads across all users' private data.
    match /{path=**}/journal_entries/{entryId} {
      allow read: if isAdmin();
    }
    match /{path=**}/mood_history/{moodId} {
      allow read: if isAdmin();
    }
    match /{path=**}/ai_conversations/{document=**} {
      allow read: if isAdmin();
    }

    // Everything else is denied by default until its own rules are written.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
